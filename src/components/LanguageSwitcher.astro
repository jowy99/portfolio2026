---
import { locales, type Locale } from "../i18n/locales";
import { t } from "../i18n/t";
import { getPathSegmentsWithoutLocale } from "../utils/i18n";
import HeaderDropdown from "./HeaderDropdown.astro";

interface Props {
  lang: Locale;
  currentPath?: string;
  search?: string;
  hash?: string;
  id?: string;
  variant?: "header" | "panel";
}

const { lang, currentPath = "/", search = "", hash = "", id = "lang-select", variant = "header" } = Astro.props;
const rest = getPathSegmentsWithoutLocale(currentPath);

const localeLabels: Record<Locale, string> = {
  es: "Español",
  en: "English",
  ca: "Català",
  fr: "Français",
};

const buildLocalePath = (targetLocale: Locale): string => {
  const base = `/${targetLocale}${rest.length ? `/${rest.join("/")}` : ""}`;
  return `${base}${search}${hash}`;
};

const items = locales.map((locale) => ({
  id: `${id}-${locale}`,
  label: variant === "panel" ? locale.toUpperCase() : localeLabels[locale],
  ariaLabel: variant === "panel" ? `${locale.toUpperCase()}, ${localeLabels[locale]}` : localeLabels[locale],
  current: locale === lang,
  href: buildLocalePath(locale),
  lang: locale,
}));
---

<HeaderDropdown
  id={id}
  label={t(lang, "langLabel")}
  currentLabel={lang.toUpperCase()}
  items={items}
  variant={variant}
/>

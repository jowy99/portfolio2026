---
import { resolveTech } from "../utils/tech";
import { getTechIcon } from "../utils/tech-icons";

interface Props {
  stack: string;
  className?: string;
}

const { stack, className = "h-4 w-4" } = Astro.props;
const tech = resolveTech(stack);
const fallbackLabel = tech.shortLabel;
const icon = getTechIcon(tech.key);
const iconScale = icon?.scale ?? 1;
---

{
  icon ? (
    <svg
      class:list={["tech-icon-svg", className]}
      viewBox={icon.viewBox}
      fill="none"
      aria-hidden="true"
      focusable="false"
      preserveAspectRatio="xMidYMid meet"
      style={`--tech-icon-scale:${iconScale};`}
      set:html={icon.body}
    ></svg>
  ) : (
    <span class:list={["tech-icon-fallback", className]} aria-hidden="true">
      {fallbackLabel}
    </span>
  )
}

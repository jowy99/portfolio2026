---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Locale } from "../i18n/locales";
import { t } from "../i18n/t";
import TechBadge from "./TechBadge.astro";

interface Props {
  lang: Locale;
  title: string;
  description: string;
  role?: string;
  stack: string[];
  links: { live?: string; github?: string };
  body: string;
  cover?: ImageMetadata;
}

const { lang, title, description, role, stack, links, body, cover } = Astro.props;

type Block = { kind: "p" | "h"; text: string } | { kind: "ol" | "ul"; items: string[] };
type Chapter = { title: string; blocks: Block[] };

const parseChapters = (markdown: string): Chapter[] =>
  markdown
    .split(/^## /m)
    .slice(1)
    .map((chunk) => {
      const [heading = "", ...rest] = chunk.split("\n");
      const blocks: Block[] = [];
      for (const part of rest.join("\n").split(/\n\s*\n/).map((value) => value.trim()).filter(Boolean)) {
        const lines = part.split("\n").map((line) => line.trim());
        if (lines.length === 1 && lines[0]?.startsWith("### ")) {
          blocks.push({ kind: "h", text: lines[0].slice(4) });
        } else if (lines.every((line) => /^\d+\.\s/.test(line))) {
          blocks.push({ kind: "ol", items: lines.map((line) => line.replace(/^\d+\.\s/, "")) });
        } else if (lines.every((line) => line.startsWith("- "))) {
          blocks.push({ kind: "ul", items: lines.map((line) => line.slice(2)) });
        } else {
          blocks.push({ kind: "p", text: lines.join(" ") });
        }
      }
      return { title: heading.trim(), blocks };
    });

const chapters = parseChapters(body);
const lead = description.split(/(?<=\.)\s/)[0];
const badges = (role ?? "")
  .split(",")
  .map((part) => part.trim())
  .filter(Boolean)
  .map((part) => part[0]!.toUpperCase() + part.slice(1));
---

<article class="site-container story">
  <header class="story-head">
    {badges.length > 0 && <p class="story-status">{badges.join(" · ")}</p>}
    <h1 class="story-title">{title}</h1>
    <p class="muted story-lead">{lead}</p>
    <ul class="story-tools" aria-label={t(lang, "projectStackAria")}>
      {stack.map((item) => <li><TechBadge stack={item} /></li>)}
    </ul>
    <div class="story-links">
      {links.github && <a href={links.github} class="btn btn-secondary min-h-11" target="_blank" rel="noopener noreferrer"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><use href="#icon-github"></use></svg>{t(lang, "projectGithub")}</a>}
      {links.live && <a href={links.live} class="btn btn-secondary min-h-11" target="_blank" rel="noopener noreferrer"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><use href="#icon-globe"></use></svg>{t(lang, "projectLive")}</a>}
      <a href={`/${lang}/#contact`} class="btn btn-primary min-h-11">{t(lang, "ctaContact")}</a>
    </div>
  </header>

  {cover && (
    <div class="story-media">
      <Image src={cover} alt={title} widths={[480, 640, 800, 960, 1280]} sizes="(min-width: 960px) 880px, calc(100vw - 32px)" loading="eager" decoding="async" fetchpriority="high" />
    </div>
  )}

  <div class="story-accordion">
    {
      chapters.map((chapter, index) => (
        <details class="story-section" name="project-story" open={index === 0}>
          <summary class="story-summary">
            <span class="story-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <h2 class="story-heading">{chapter.title}</h2>
            <svg class="story-caret" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </summary>
          <div class="story-body">
            {
              chapter.blocks.map((block) => (
                <Fragment>
                  {block.kind === "h" && <h3 class="story-subhead">{block.text}</h3>}
                  {block.kind === "p" && <p class="story-text">{block.text}</p>}
                  {(block.kind === "ul" || block.kind === "ol") && <ul class="story-cards">
                        {block.items.map((item) => <li class="story-card">{item}</li>)}
                      </ul>}
                </Fragment>
              ))
            }
          </div>
        </details>
      ))
    }
  </div>
</article>

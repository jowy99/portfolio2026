---
import type { Locale } from "../i18n/locales";
import { t } from "../i18n/t";
import { resolveBackLink } from "../utils/navigation";

interface Props {
  lang: Locale;
  pathname: string;
  variant?: "top" | "footer";
}

const { lang, pathname, variant = "top" } = Astro.props;
const backLink = resolveBackLink(lang, pathname);
const label = backLink ? t(lang, backLink.labelKey) : "";
---

{
  backLink && (
    <div class:list={["site-container back-link-shell", variant === "footer" && "back-link-shell-footer"]} data-reveal>
      <div class:list={[variant === "footer" && "back-link-footer-panel"]}>
        <a href={backLink.href} class:list={["back-link", variant === "footer" && "back-link-footer"]}>
          <svg class="back-link-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M9 12h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <span class="truncate">{label}</span>
        </a>
      </div>
    </div>
  )
}

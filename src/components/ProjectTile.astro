---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Locale } from "../i18n/locales";
import { t } from "../i18n/t";
import { resolveProjectCover } from "../utils/project-covers";
import { resolveTech } from "../utils/tech";
import SkillIcon from "./SkillIcon.astro";

interface Props {
  lang: Locale;
  slug: string;
  title: string;
  description: string;
  cover: ImageMetadata | string;
  stack: string[];
  links?: { live?: string; github?: string };
  priority?: boolean;
}

const { lang, slug, title, description, cover, stack, links = {}, priority = false } = Astro.props;
const resolvedCover = resolveProjectCover(cover);
const imageLoading = priority ? "eager" : "lazy";
---

<article class="featured-card project-tile">
  <div class="featured-media">
    {
      typeof resolvedCover === "string" ? (
        <img src={resolvedCover} alt="" loading={imageLoading} decoding="async" />
      ) : (
        <Image src={resolvedCover} alt="" widths={[240, 360, 480, 640, 800]} sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 112px" loading={imageLoading} decoding="async" fetchpriority={priority ? "high" : "auto"} />
      )
    }
  </div>
  <div class="featured-body">
    <h3 class="featured-title">
      <a href={`/${lang}/projects/${slug}`} class="featured-link">{title}</a>
    </h3>
    <p class="featured-description project-tile-description muted">{description}</p>
    <ul class="project-tile-stack" aria-label={t(lang, "projectStackAria")}>
      {
        stack.map((item) => {
          const label = resolveTech(item).label;
          return (
            <li class="project-tile-icon" title={label}>
              <SkillIcon stack={item} className="h-4 w-4" />
              <span class="sr-only">{label}</span>
            </li>
          );
        })
      }
    </ul>
    {(links.github || links.live) && (
      <div class="featured-actions project-tile-actions">
        {links.github && (
          <a href={links.github} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><use href="#icon-github"></use></svg>
            {t(lang, "projectGithub")}
          </a>
        )}
        {links.live && (
          <a href={links.live} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><use href="#icon-globe"></use></svg>
            {t(lang, "projectLive")}
          </a>
        )}
      </div>
    )}
  </div>
</article>

---
import Section from "./Section.astro";
import type { Locale } from "../i18n/locales";
import { t } from "../i18n/t";
import contactFormScript from "../scripts/contact-form.js?raw";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

---

<Section id="contact" className="defer-content">
  <div class="contact-unified" data-reveal>
    <div class="contact-copy-panel">
      <h2 class="text-4xl font-semibold leading-[1.05] sm:text-5xl">{t(lang, "contactTitle")}</h2>
      <p class="muted mt-6 max-w-md text-sm leading-relaxed">{t(lang, "contactSubtitle")}</p>
    </div>

    <div class="contact-form-panel">
      <div class="contact-form-shell">
        <form
          class="grid gap-4 sm:grid-cols-2"
          method="post"
          action="/api/contact"
          aria-label={t(lang, "contactTitle")}
          data-contact-form
          data-msg-sending={t(lang, "contact.status.sending")}
          data-msg-success={t(lang, "contact.status.success")}
          data-msg-error={t(lang, "contact.status.errorGeneric")}
          data-msg-invalid={t(lang, "contact.feedback.invalid")}
          data-msg-rate-limit={t(lang, "contact.feedback.rateLimit")}
          data-msg-unavailable={t(lang, "contact.feedback.unavailable")}
        >
            <label class="contact-field-group" for={`contact-name-${lang}`}>
              <span class="label">{`${t(lang, "contact.nameLabel")}*`}</span>
              <input
                id={`contact-name-${lang}`}
                type="text"
                name="name"
                autocomplete="name"
                minlength="2"
                maxlength="80"
                required
                aria-required="true"
                class="field"
                placeholder={t(lang, "contact.namePlaceholder")}
              />
            </label>

            <label class="contact-field-group" for={`contact-email-${lang}`}>
              <span class="label">{`${t(lang, "contact.emailLabel")}*`}</span>
              <input
                id={`contact-email-${lang}`}
                type="email"
                name="email"
                autocomplete="email"
                maxlength="120"
                pattern={"[^\\s@]+@[^\\s@]+\\.[^\\s@]+"}
                required
                aria-required="true"
                class="field"
                placeholder={t(lang, "contact.emailPlaceholder")}
              />
            </label>

            <label class="contact-field-group sm:col-span-2" for={`contact-message-${lang}`}>
              <span class="label">{`${t(lang, "contact.messageLabel")}*`}</span>
              <textarea
                id={`contact-message-${lang}`}
                rows="5"
                name="message"
                minlength="10"
                maxlength="4000"
                required
                aria-required="true"
                class="field field-textarea"
                placeholder={t(lang, "contact.messagePlaceholder")}
              ></textarea>
            </label>

          <input
            id={`contact-company-${lang}`}
            type="text"
            name="company"
            tabindex="-1"
            autocomplete="off"
            class="sr-only"
            aria-label={t(lang, "contact.companyField")}
            aria-hidden="true"
          />

          <input type="hidden" name="form_started_at" value="" data-contact-started-at />
          <input type="hidden" name="lang" value={lang} />
          <input type="hidden" name="redirect_to" value={`/${lang}/#contact`} />

          <button
            type="submit"
            class="btn btn-primary min-h-11 w-full sm:col-span-2 motion-safe:hover:-translate-y-0.5 transition-transform disabled:cursor-wait disabled:opacity-60"
            data-contact-submit
            data-label-default={t(lang, "contactSend")}
            data-label-sending={t(lang, "contact.status.sending")}
          >
            {t(lang, "contactSend")}
          </button>
          <p class="contact-form-status notice hidden sm:col-span-2" data-contact-status role="status" aria-live="polite" aria-atomic="true" aria-hidden="true"></p>
        </form>
      </div>
    </div>
  <ul class="contact-links">
        <li>
          <a href="https://www.linkedin.com/in/joelarnaudcarreras/" target="_blank" rel="noopener noreferrer" class="btn btn-secondary min-h-11">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.94 8.56H3.56V20h3.38V8.56ZM5.25 3.08a1.96 1.96 0 1 0 0 3.92 1.96 1.96 0 0 0 0-3.92ZM20.44 13.4c0-3.45-1.84-5.06-4.3-5.06-1.98 0-2.87 1.09-3.37 1.86V8.56H9.4c.04 1.09 0 11.44 0 11.44h3.37v-6.39c0-.34.03-.68.13-.92.27-.68.89-1.38 1.93-1.38 1.36 0 1.9 1.04 1.9 2.56V20h3.37l.34-6.6Z"></path></svg>
            <span>{t(lang, "contactLinkedIn")}</span>
          </a>
        </li>
        <li>
          <a href="https://github.com/jowy99" target="_blank" rel="noopener noreferrer" class="btn btn-secondary min-h-11">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><use href="#icon-github"></use></svg>
            <span>{t(lang, "projectGithub")}</span>
          </a>
        </li>
        <li>
          <a href="/cv-joel-arnaud.pdf" download class="btn btn-secondary min-h-11">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m0 0 4-4m-4 4-4-4M5 20h14"></path></svg>
            <span>{t(lang, "heroDownloadCv")}</span>
          </a>
        </li>
      </ul>
  </div>
</Section>

<script is:inline set:html={contactFormScript}></script>

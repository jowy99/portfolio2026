---
import type { Locale } from "../i18n/locales";
import { t } from "../i18n/t";
import HeaderDropdown from "./HeaderDropdown.astro";

interface Props {
  lang: Locale;
  id?: string;
  variant?: "header" | "panel";
}

const { lang, id = "theme-select", variant = "header" } = Astro.props;
const items = [
  { id: `${id}-system`, label: t(lang, "themeSystem"), value: "system", current: true },
  { id: `${id}-light`, label: t(lang, "themeLight"), value: "light", current: false },
  { id: `${id}-dark`, label: t(lang, "themeDark"), value: "dark", current: false },
];
---

<HeaderDropdown
  id={id}
  label={t(lang, "themeLabel")}
  currentLabel={t(lang, "themeSystem")}
  items={items}
  icon="theme"
  variant={variant}
/>

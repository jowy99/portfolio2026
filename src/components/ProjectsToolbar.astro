---
import type { Locale } from "../i18n/locales";
import { t } from "../i18n/t";
import { buildHrefWithParams, buildProjectsParams, normalizeToken } from "../utils/url";
import SkillIcon from "./SkillIcon.astro";
import { resolveTech } from "../utils/tech";

interface Props {
  lang: Locale;
  basePath: string;
  q: string;
  sort: "relevance" | "recent" | "impact";
  stacks: string[];
  selectedStacks: string[];
  activeCount: number;
}

const { lang, basePath, q, sort, stacks, selectedStacks, activeCount } = Astro.props;
const selectedStacksNorm = new Set(selectedStacks.map((stack) => normalizeToken(stack)));

---

<div class="projects-toolbar">
  <form method="get" action={basePath} class="space-y-3" data-projects-toolbar-form>
    <div class="projects-toolbar-main">
      <div class="projects-search-shell min-w-0 flex-1">
        <label class="sr-only" for="projects-search">{t(lang, "searchPlaceholder")}</label>
        <span class="projects-search-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
            <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"></circle>
            <path d="M16 16l4.2 4.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
          </svg>
        </span>
        <input
          id="projects-search"
          type="text"
          name="q"
          value={q}
          placeholder={t(lang, "searchPlaceholder")}
          class="projects-search-input"
          autocomplete="off"
          data-projects-search-input
        />
        <button
          type="button"
          class:list={["projects-search-clear", q && "is-visible"]}
          aria-label={t(lang, "clearFilters")}
          disabled={!q.trim()}
          data-projects-search-clear
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>

      <details class="projects-tech-menu" data-projects-tech-menu>
        <summary class="ui-dropdown-trigger projects-tech-trigger">
          <span>{t(lang, "projects.techLabel")}</span>
          <span class:list={["projects-tech-count", selectedStacks.length > 0 && "is-active"]} data-projects-tech-count>{selectedStacks.length > 0 ? selectedStacks.length : ""}</span>
          <svg class="projects-tech-caret" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </summary>
        <div class="ui-panel-surface projects-tech-panel">
          <div class="projects-tech-list">
            {
              stacks.map((stackItem) => (
                <label class="projects-tech-option">
                  <input type="checkbox" name="stack" value={stackItem} checked={selectedStacksNorm.has(normalizeToken(stackItem))} data-projects-stack-checkbox />
                  <SkillIcon stack={stackItem} className="h-4 w-4" />
                  <span>{resolveTech(stackItem).label}</span>
                </label>
              ))
            }
          </div>
          <button type="button" class="projects-tech-clear" data-projects-tech-clear>{t(lang, "clearFilters")}</button>
        </div>
      </details>

      <button
        type="button"
        class="ui-dropdown-trigger projects-sort-toggle"
        aria-label={`${t(lang, "sortLabel")}: ${t(lang, sort === "recent" ? "sortRecent" : "sortRelevance")}`}
        data-projects-sort-toggle
        data-prefix={t(lang, "sortLabel")}
        data-label-relevance={t(lang, "sortRelevance")}
        data-label-recent={t(lang, "sortRecent")}
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M8 4v16M8 4 4 8m4-4 4 4M16 20V4m0 16 4-4m-4 4-4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span data-projects-sort-label>{t(lang, sort === "recent" ? "sortRecent" : "sortRelevance")}</span>
      </button>
    </div>

    <select id="projects-sort" name="sort" class="projects-sort-native" aria-label={t(lang, "sortLabel")} data-projects-sort-select>
      <option value="relevance" selected={sort !== "recent"}>{t(lang, "sortRelevance")}</option>
      <option value="recent" selected={sort === "recent"}>{t(lang, "sortRecent")}</option>
    </select>

    <noscript>
      <style is:inline>
        .projects-sort-toggle { display: none; }
        .projects-sort-native { display: block; }
      </style>
      <button type="submit" class="btn btn-primary">{t(lang, "applyFilters")}</button>
    </noscript>
  </form>
</div>

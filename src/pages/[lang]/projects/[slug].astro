---
import { getCollection } from "astro:content";
import ProjectStory from "../../../components/ProjectStory.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import type { Locale } from "../../../i18n/locales";
import { t } from "../../../i18n/t";
import { assertLocale } from "../../../utils/i18n";
import { getProjectCoverSrc, resolveProjectCover } from "../../../utils/project-covers";
import { filterProjectsByLocale, getProjectLocale, getProjectSlug } from "../../../utils/projects";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects
    .map((project) => {
      const locale = getProjectLocale(project);
      if (!locale) return null;
      return {
        params: {
          lang: locale,
          slug: getProjectSlug(project),
        },
      };
    })
    .filter((path): path is { params: { lang: Locale; slug: string } } => Boolean(path));
}

const lang: Locale = assertLocale(Astro.params.lang);
const slug = Astro.params.slug;

const projects = filterProjectsByLocale(await getCollection("projects"), lang);
const project = projects.find((entry) => getProjectSlug(entry) === slug);

if (!project) {
  throw new Error(`${t(lang, "projects.errors.notFound")}: ${slug}`);
}

const siteOrigin = Astro.site?.toString().replace(/\/$/, "");
const projectPath = `/${lang}/projects/${getProjectSlug(project)}`;
const projectsPath = `/${lang}/projects`;
const projectUrl = siteOrigin ? `${siteOrigin}${projectPath}` : projectPath;
const projectsUrl = siteOrigin ? `${siteOrigin}${projectsPath}` : projectsPath;
const homeUrl = siteOrigin ? `${siteOrigin}/${lang}` : `/${lang}`;
const resolvedCover = resolveProjectCover(project.data.cover);
const coverSrc = getProjectCoverSrc(project.data.cover);
const coverUrl = siteOrigin ? new URL(coverSrc, `${siteOrigin}/`).toString() : coverSrc;
const sameAsLinks = [project.data.links.live, project.data.links.github].filter((value): value is string => Boolean(value));
const projectStructuredData = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  headline: project.data.title,
  name: project.data.title,
  description: project.data.description,
  url: projectUrl,
  image: coverUrl,
  inLanguage: lang,
  datePublished: project.data.date.toISOString(),
  dateModified: project.data.date.toISOString(),
  keywords: project.data.stack.join(", "),
  ...(sameAsLinks.length > 0 ? { sameAs: sameAsLinks } : {}),
  author: {
    "@type": "Person",
    name: t(lang, "siteName"),
    url: homeUrl,
  },
};
const breadcrumbStructuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: t(lang, "siteName"),
      item: homeUrl,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: t(lang, "projectsTitle"),
      item: projectsUrl,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: project.data.title,
      item: projectUrl,
    },
  ],
};
---

<BaseLayout
  lang={lang}
  title={`${project.data.title} | ${t(lang, "siteName")}`}
  description={project.data.description}
  image={resolvedCover}
  type="article"
  publishedTime={project.data.date.toISOString()}
  updatedTime={project.data.date.toISOString()}
  bottomBackLink={true}
  bottomContact={true}
  bottomLinks={project.data.links}
  structuredData={[breadcrumbStructuredData, projectStructuredData]}
>
  <ProjectStory
    lang={lang}
    title={project.data.title}
    description={project.data.description}
    role={project.data.role}
    stack={project.data.stack}
    links={project.data.links}
    body={project.body ?? ""}
    cover={typeof resolvedCover === "string" ? undefined : resolvedCover}
  />

</BaseLayout>

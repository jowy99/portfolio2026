---
import { Picture } from "astro:assets";
import { getCollection } from "astro:content";
import ProjectCard from "../../components/ProjectCard.astro";
import Section from "../../components/Section.astro";
import TechBadge from "../../components/TechBadge.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { locales, type Locale } from "../../i18n/locales";
import { t, tList, tValue } from "../../i18n/t";
import { assertLocale } from "../../utils/i18n";
import { filterProjectsByLocale, getProjectSlug } from "../../utils/projects";
import heroPhoto from "../../assets/hero/joel.jpeg";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang: Locale = assertLocale(Astro.params.lang);

const orderedProjects = filterProjectsByLocale(await getCollection("projects"), lang).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const featuredOrder = ["fincas-es-moli", "weather-app", "emotions-app"];
const featuredOrderSet = new Set(featuredOrder);
const featuredByOrder = featuredOrder
  .map((slug) => orderedProjects.find((project) => getProjectSlug(project) === slug))
  .filter((project): project is (typeof orderedProjects)[number] => Boolean(project));
const nonPinned = orderedProjects.filter((project) => !featuredOrderSet.has(getProjectSlug(project)));
const featuredProjects = [...featuredByOrder, ...nonPinned].slice(0, 4);

const projectsHref = `/${lang}/projects`;
const contactHref = `/${lang}/#contact`;
const heroStack = tList(lang, "hero.stack");
const siteOrigin = Astro.site?.toString().replace(/\/$/, "");
const localeHomeUrl = siteOrigin ? `${siteOrigin}/${lang}` : undefined;
const rootSiteUrl = siteOrigin ? `${siteOrigin}/` : undefined;
const sameAsProfiles = ["https://www.linkedin.com/in/joelarnaudcarreras/", "https://github.com/jowy99"];
const homeStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: t(lang, "siteName"),
    jobTitle: t(lang, "seo.person.jobTitle"),
    ...(localeHomeUrl ? { url: localeHomeUrl } : {}),
    sameAs: sameAsProfiles,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: t(lang, "siteName"),
    ...(rootSiteUrl ? { url: rootSiteUrl } : {}),
    inLanguage: lang,
  },
];

const heroBullets = [t(lang, "hero.bullet1"), t(lang, "hero.bullet2"), t(lang, "hero.bullet3")];
const profileWhyBullets = tList(lang, "profile.why.bullets");
const profileWhyOptimizeItems = tList(lang, "profile.why.optimizeItems");
const profileWhyWorkItems = tList(lang, "profile.why.workItems");
const profileWhySignals = [
  t(lang, "profile.why.b1"),
  t(lang, "profile.why.b2"),
  t(lang, "profile.why.b3"),
  t(lang, "profile.why.b4"),
];
const profileSkillsItems = tList(lang, "profile.skills.items");
const profileLanguageItems = tList(lang, "profile.lang.items");
const profileTabs = [
  { id: "why", labelKey: "profile.tab.why", shortLabelKey: "profile.tab.short.why" },
  { id: "skills", labelKey: "profile.tab.skills", shortLabelKey: "profile.tab.short.skills" },
  { id: "edu", labelKey: "profile.tab.edu", shortLabelKey: "profile.tab.short.edu" },
  { id: "lang", labelKey: "profile.tab.lang", shortLabelKey: "profile.tab.short.lang" },
] as const;
const splitLabelValue = (value: string) => {
  const [label, ...rest] = value.split(":");
  return {
    label: label?.trim() ?? value.trim(),
    value: rest.join(":").trim(),
  };
};
const isString = (value: string | null): value is string => value !== null;
const profileLanguages = profileLanguageItems.map(splitLabelValue);
const profileSkillLookup = new Map(profileSkillsItems.map((item) => [item.toLowerCase(), item]));
const profileSkillsDisplayOrder = [
  "AstroJS",
  "Next.js",
  "Laravel",
  "TypeScript",
  "JavaScript",
  "TailwindCSS",
  "HTML5",
  "CSS3",
  "Python",
  "Java",
  "Git",
  "MySQL",
];
const profileSkillsDisplayItems = [
  ...profileSkillsDisplayOrder
    .map((item) => profileSkillLookup.get(item.toLowerCase()) ?? null)
    .filter(isString),
  ...profileSkillsItems.filter((item) => !profileSkillsDisplayOrder.some((entry) => entry.toLowerCase() === item.toLowerCase())),
];
const contactWhyPoints = [
  t(lang, "contact.whyPoint1"),
  t(lang, "contact.whyPoint2"),
  t(lang, "contact.whyPoint3"),
];

type EducationItem = {
  period: string;
  title: string;
  summary: string;
  highlights: string[];
};

const readEducationItems = (value: unknown): EducationItem[] => {
  if (!Array.isArray(value)) return [];
  return value
    .map((item) => {
      if (!item || typeof item !== "object") return null;
      const entry = item as Record<string, unknown>;
      const period = typeof entry.period === "string" ? entry.period.trim() : "";
      const title = typeof entry.title === "string" ? entry.title.trim() : "";
      const summary = typeof entry.summary === "string" ? entry.summary.trim() : "";
      const highlights = Array.isArray(entry.highlights)
        ? entry.highlights.filter((highlight): highlight is string => typeof highlight === "string" && highlight.trim().length > 0)
        : [];

      if (!period || !title) return null;
      return { period, title, summary, highlights };
    })
    .filter((entry): entry is EducationItem => Boolean(entry));
};

const profileEducationTimeline = readEducationItems(tValue(lang, "profile.edu.timeline"));
const profileEducationCourses = readEducationItems(tValue(lang, "profile.edu.courses"));
---

<BaseLayout
  lang={lang}
  title={t(lang, "meta.homeTitle")}
  description={t(lang, "meta.homeDescription")}
  structuredData={homeStructuredData}
>
  <section class="flex min-h-[calc(86svh-4.15rem)] items-center py-10 sm:min-h-[calc(100svh-4.15rem)] sm:py-16" data-reveal>
    <div class="site-container w-full">
      <div class="relative z-10 grid w-full items-center gap-10 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)]">
          <div>
            <p class="hero-kicker">{t(lang, "hero.eyebrow")}</p>
            <h1 class="mt-4 max-w-3xl text-4xl font-semibold leading-tight sm:text-5xl lg:text-6xl">{t(lang, "hero.title")}</h1>
            <p class="muted mt-5 max-w-2xl text-lg leading-relaxed">{t(lang, "hero.subtitle")}</p>
            <div class="hero-mobile-glimpse sm:hidden">
              <div class="hero-mobile-thumb-shell">
                <Picture
                  src={heroPhoto}
                  alt={t(lang, "heroPhotoAlt")}
                  class="hero-mobile-thumb"
                  formats={["avif", "webp", "jpeg"]}
                  widths={[224, 320, 448]}
                  width={320}
                  height={400}
                  sizes="112px"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                />
              </div>
              <div class="hero-mobile-meta">
                <p class="hero-mobile-note">{t(lang, "heroPhotoNote")}</p>
                <p class="hero-mobile-status">
                  <span class="hero-status-dot" aria-hidden="true"></span>
                  <span>{t(lang, "hero.cardStatus")}</span>
                </p>
              </div>
            </div>

            <ul class="tech-badge-list tech-badge-list-hero mt-4">
              {
                heroStack.map((item, index) => (
                  <li style={`--chip-index: ${index};`}>
                    <TechBadge stack={item} className="hero-stack-chip" />
                  </li>
                ))
              }
            </ul>

            <ul class="hero-list hidden sm:block">
              {
                heroBullets.map((point) => (
                  <li class="hero-list-item">
                    <span class="hero-list-dot" aria-hidden="true"></span>
                    <span>{point}</span>
                  </li>
                ))
              }
            </ul>

            <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
              <a href={projectsHref} class="btn btn-primary hero-cta-pulse w-full sm:w-auto">{t(lang, "hero.ctaProjects")}</a>
              <a href={contactHref} class="btn btn-secondary w-full sm:w-auto">{t(lang, "hero.ctaTalk")}</a>
            </div>

          </div>

          <div class="hero-visual-wrap hidden sm:block">
            <div class="hero-media-frame">
              <Picture
                src={heroPhoto}
                alt={t(lang, "heroPhotoAlt")}
                class="hero-media"
                formats={["avif", "webp", "jpeg"]}
                widths={[360, 540, 720, 960]}
                width={960}
                height={960}
                sizes="(max-width: 640px) 90vw, (min-width: 1024px) 28rem, 50vw"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
              <span class="hero-media-caption">{t(lang, "heroPhotoNote")}</span>
            </div>

            <div class="hero-float-card">
              <p class="hero-float-title">
                <span class="hero-status-dot" aria-hidden="true"></span>
                <span>{t(lang, "hero.cardStatus")}</span>
              </p>
            </div>
          </div>
        </div>
    </div>
  </section>

  <Section id="projects" title={t(lang, "home.featuredTitle")} className="defer-content">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-6" data-reveal>
      {
        featuredProjects.map((project, index) => (
          <div>
            <ProjectCard
              lang={lang}
              slug={getProjectSlug(project)}
              title={project.data.title}
              description={project.data.description}
              cover={project.data.cover}
              stack={project.data.stack}
              links={project.data.links}
              maxStack={4}
              priority={index < 2}
            />
          </div>
        ))
      }
    </div>

    <div class="mt-6" data-reveal>
      <a href={projectsHref} class="btn btn-secondary">{t(lang, "home.featuredCtaAll")}</a>
    </div>
  </Section>

  <Section id="about" title={t(lang, "profile.title")} intro={t(lang, "profile.subtitle")} className="defer-content">
    <div class="profile-layout min-w-0 max-w-full overflow-x-hidden" data-profile-tabs data-default-tab="why" data-reveal>
      <div
        role="tablist"
        aria-label={t(lang, "profile.title")}
        data-profile-tablist
        class="profile-tablist-mobile lg:hidden"
      >
        {
          profileTabs.map((tab, index) => (
            <button
              id={`about-tab-mobile-${tab.id}-${lang}`}
              type="button"
              role="tab"
              aria-selected={tab.id === "why" ? "true" : "false"}
              aria-controls={`about-panel-${tab.id}-${lang}`}
              aria-label={t(lang, tab.labelKey)}
              tabindex={tab.id === "why" ? "0" : "-1"}
              class="profile-tab profile-tab-mobile"
              data-profile-tab={tab.id}
            >
              <span class="profile-tab-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <span class="profile-tab-label">{t(lang, tab.shortLabelKey)}</span>
            </button>
          ))
        }
      </div>

      <div class="profile-shell">
        <aside class="profile-sidebar hidden self-start lg:sticky lg:block lg:self-start">
          <div
            role="tablist"
            aria-label={t(lang, "profile.title")}
            data-profile-tablist
            class="profile-tablist-desktop space-y-2"
          >
            {
              profileTabs.map((tab, index) => (
                <button
                  id={`about-tab-desktop-${tab.id}-${lang}`}
                  type="button"
                  role="tab"
                  aria-selected={tab.id === "why" ? "true" : "false"}
                  aria-controls={`about-panel-${tab.id}-${lang}`}
                  tabindex={tab.id === "why" ? "0" : "-1"}
                  class="profile-tab profile-tab-desktop"
                  data-profile-tab={tab.id}
                >
                  <span class="profile-tab-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                  <span class="profile-tab-label">{t(lang, tab.labelKey)}</span>
                </button>
              ))
            }
          </div>
        </aside>

        <div class="profile-stage" data-profile-stage>
          <section
            id={`about-panel-why-${lang}`}
            role="tabpanel"
            aria-labelledby={`about-tab-mobile-why-${lang} about-tab-desktop-why-${lang}`}
            tabindex="0"
            data-profile-panel="why"
            class="profile-panel min-w-0 max-w-full overflow-x-hidden"
          >
            <header class="profile-panel-header">
              <h3 class="profile-panel-title">{t(lang, "profile.why.heading")}</h3>
            </header>

            <ul class="profile-signal-list" aria-label={t(lang, "profile.tab.why")}>
              {
                profileWhySignals.map((item) => (
                  <li>{item}</li>
                ))
              }
            </ul>

            <div class="profile-editorial-grid">
              <div class="profile-copy-block">
                <p class="profile-side-label">{t(lang, "profile.why.valueTitle")}</p>
                <ul class="profile-bullet-list">
                  {
                    profileWhyBullets.map((item) => (
                      <li>{item}</li>
                    ))
                  }
                </ul>
              </div>

              <div class="profile-side-stack">
                <section class="profile-side-block">
                  <p class="profile-side-label">{t(lang, "profile.why.optimizeTitle")}</p>
                  <ul class="profile-detail-list">
                    {
                      profileWhyOptimizeItems.map((item) => (
                        <li>{item}</li>
                      ))
                    }
                  </ul>
                </section>

                <section class="profile-side-block">
                  <p class="profile-side-label">{t(lang, "profile.why.workTitle")}</p>
                  <ul class="profile-detail-list">
                    {
                      profileWhyWorkItems.map((item) => (
                        <li>{item}</li>
                      ))
                    }
                  </ul>
                </section>
              </div>
            </div>
          </section>

          <section
            id={`about-panel-skills-${lang}`}
            role="tabpanel"
            aria-labelledby={`about-tab-mobile-skills-${lang} about-tab-desktop-skills-${lang}`}
            tabindex="0"
            data-profile-panel="skills"
            class="profile-panel min-w-0 max-w-full overflow-x-hidden"
            hidden
            aria-hidden="true"
          >
            <header class="profile-panel-header">
              <h3 class="profile-panel-title">{t(lang, "profile.tab.skills")}</h3>
            </header>

            <ul class="profile-skills-grid">
              {
                profileSkillsDisplayItems.map((item) => (
                  <li><TechBadge stack={item} /></li>
                ))
              }
            </ul>
          </section>

          <section
            id={`about-panel-edu-${lang}`}
            role="tabpanel"
            aria-labelledby={`about-tab-mobile-edu-${lang} about-tab-desktop-edu-${lang}`}
            tabindex="0"
            data-profile-panel="edu"
            class="profile-panel min-w-0 max-w-full overflow-x-hidden"
            hidden
            aria-hidden="true"
          >
            <header class="profile-panel-header">
              <h3 class="profile-panel-title">{t(lang, "profile.tab.edu")}</h3>
            </header>

            <div class="profile-education-grid">
              <section class="profile-section-block">
                <h4 class="profile-subsection-title">{t(lang, "profile.edu.sectionTitle")}</h4>
                <ol class="profile-timeline">
                  {
                    profileEducationTimeline.map((entry) => (
                      <li class="profile-timeline-item">
                        <span class="profile-timeline-marker" aria-hidden="true"></span>
                        <p class="profile-timeline-period">{entry.period}</p>
                        <p class="profile-timeline-title">{entry.title}</p>
                        {entry.summary && <p class="profile-timeline-summary">{entry.summary}</p>}
                        {entry.highlights.length > 0 && (
                          <ul class="profile-detail-list profile-detail-list-compact">
                            {entry.highlights.map((highlight) => <li>{highlight}</li>)}
                          </ul>
                        )}
                      </li>
                    ))
                  }
                </ol>
              </section>

              <section class="profile-section-block">
                <h4 class="profile-subsection-title">{t(lang, "profile.edu.coursesTitle")}</h4>
                <ol class="profile-timeline">
                  {
                    profileEducationCourses.map((entry) => (
                      <li class="profile-timeline-item">
                        <span class="profile-timeline-marker" aria-hidden="true"></span>
                        <p class="profile-timeline-period">{entry.period}</p>
                        <p class="profile-timeline-title">{entry.title}</p>
                        {entry.summary && <p class="profile-timeline-summary">{entry.summary}</p>}
                        {entry.highlights.length > 0 && (
                          <ul class="profile-detail-list profile-detail-list-compact">
                            {entry.highlights.map((highlight) => <li>{highlight}</li>)}
                          </ul>
                        )}
                      </li>
                    ))
                  }
                </ol>
              </section>
            </div>
          </section>

          <section
            id={`about-panel-lang-${lang}`}
            role="tabpanel"
            aria-labelledby={`about-tab-mobile-lang-${lang} about-tab-desktop-lang-${lang}`}
            tabindex="0"
            data-profile-panel="lang"
            class="profile-panel min-w-0 max-w-full overflow-x-hidden"
            hidden
            aria-hidden="true"
          >
            <header class="profile-panel-header">
              <h3 class="profile-panel-title">{t(lang, "profile.tab.lang")}</h3>
            </header>

            <div class="profile-language-grid">
              <div class="profile-language-column">
                <h4 class="profile-subsection-title">{t(lang, "profile.lang.cardTitle")}</h4>
                <dl class="profile-language-list">
                  {
                    profileLanguages.map((item) => (
                      <div class="profile-language-item">
                        <dt class="profile-language-label">{item.label}</dt>
                        {item.value && <dd class="profile-language-value">{item.value}</dd>}
                      </div>
                    ))
                  }
                </dl>
              </div>

              <div class="profile-availability">
                <p class="profile-side-label">{t(lang, "profile.lang.availabilityTitle")}</p>
                <p class="muted text-sm leading-relaxed">{t(lang, "profile.lang.availabilityBody")}</p>
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>

    <script is:inline>
      (() => {
        const root = document.querySelector("[data-profile-tabs]");
        if (!(root instanceof HTMLElement)) return;

        const stage = root.querySelector("[data-profile-stage]");
        const tablists = Array.from(root.querySelectorAll('[role="tablist"][data-profile-tablist]'));
        const tabs = Array.from(root.querySelectorAll('[role="tab"][data-profile-tab]'));
        const panels = Array.from(root.querySelectorAll('[role="tabpanel"][data-profile-panel]'));
        if (tablists.length === 0 || tabs.length === 0 || panels.length === 0) return;

        const valid = new Set(
          tabs
            .map((tab) => tab.getAttribute("data-profile-tab"))
            .filter((value) => Boolean(value)),
        );

        const readHashTab = () => {
          const hash = window.location.hash.startsWith("#") ? window.location.hash.slice(1) : "";
          if (!hash.startsWith("profile=")) return null;
          const value = hash.slice("profile=".length);
          return valid.has(value) ? value : null;
        };

        const writeHashTab = (value) => {
          const nextHash = `#profile=${value}`;
          if (window.location.hash === nextHash) return;
          history.replaceState(null, "", `${window.location.pathname}${window.location.search}${nextHash}`);
        };

        let measureFrame = 0;
        const stableHeightQuery = window.matchMedia("(min-width: 768px)");

        const measureStageHeight = () => {
          if (!(stage instanceof HTMLElement)) return;
          if (!stableHeightQuery.matches) {
            stage.style.removeProperty("--profile-stage-min-height");
            return;
          }

          let maxHeight = 0;

          for (const panel of panels) {
            if (!(panel instanceof HTMLElement)) continue;

            const wasHidden = panel.hidden;
            const wasActive = panel.classList.contains("is-active");
            const previousAriaHidden = panel.getAttribute("aria-hidden");

            panel.hidden = false;
            panel.setAttribute("aria-hidden", "false");
            panel.classList.add("is-measuring");
            panel.classList.remove("is-active");

            maxHeight = Math.max(maxHeight, Math.ceil(panel.getBoundingClientRect().height));

            panel.classList.remove("is-measuring");
            panel.classList.toggle("is-active", wasActive);
            panel.hidden = wasHidden;

            if (previousAriaHidden === null) {
              panel.removeAttribute("aria-hidden");
            } else {
              panel.setAttribute("aria-hidden", previousAriaHidden);
            }
          }

          if (maxHeight > 0) {
            stage.style.setProperty("--profile-stage-min-height", `${maxHeight}px`);
          }
        };

        const scheduleStageMeasurement = () => {
          cancelAnimationFrame(measureFrame);
          measureFrame = requestAnimationFrame(measureStageHeight);
        };

        const activate = (value, { focus = false, updateHash = true, focusWithin = null } = {}) => {
          if (!valid.has(value)) return;

          for (const tab of tabs) {
            if (!(tab instanceof HTMLButtonElement)) continue;
            const isActive = tab.dataset.profileTab === value;
            tab.setAttribute("aria-selected", isActive ? "true" : "false");
            tab.tabIndex = isActive ? 0 : -1;
            tab.classList.toggle("is-active", isActive);
          }

          if (focus) {
            const targetTab = tabs.find((tab) => {
              if (!(tab instanceof HTMLButtonElement)) return false;
              if (tab.dataset.profileTab !== value) return false;
              if (!(focusWithin instanceof HTMLElement)) return true;
              return tab.closest("[data-profile-tablist]") === focusWithin;
            });
            if (targetTab instanceof HTMLButtonElement) targetTab.focus();
          }

          for (const panel of panels) {
            if (!(panel instanceof HTMLElement)) continue;
            const isActive = panel.dataset.profilePanel === value;
            panel.hidden = !isActive;
            panel.setAttribute("aria-hidden", isActive ? "false" : "true");
            panel.classList.toggle("is-active", isActive);
          }

          if (updateHash) writeHashTab(value);
        };

        const initial =
          readHashTab() ??
          tabs.find((tab) => tab.getAttribute("aria-selected") === "true")?.getAttribute("data-profile-tab") ??
          tabs[0]?.getAttribute("data-profile-tab") ??
          root.getAttribute("data-default-tab") ??
          "why";

        activate(initial, { updateHash: false });
        measureStageHeight();

        for (const tab of tabs) {
          if (!(tab instanceof HTMLButtonElement)) continue;
          tab.addEventListener("click", () => {
            const value = tab.dataset.profileTab;
            if (value) activate(value);
          });
        }

        for (const tablist of tablists) {
          if (!(tablist instanceof HTMLElement)) continue;
          tablist.addEventListener("keydown", (event) => {
            const key = event.key;
            if (!["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown", "Home", "End"].includes(key)) return;
            event.preventDefault();

            const listTabs = tabs.filter((tab) => tab.closest("[data-profile-tablist]") === tablist);
            const currentIndex = listTabs.findIndex((tab) => tab.getAttribute("aria-selected") === "true");
            if (currentIndex < 0) return;

            let nextIndex = currentIndex;
            if (key === "Home") nextIndex = 0;
            if (key === "End") nextIndex = listTabs.length - 1;
            if (key === "ArrowRight" || key === "ArrowDown") nextIndex = (currentIndex + 1) % listTabs.length;
            if (key === "ArrowLeft" || key === "ArrowUp") nextIndex = (currentIndex - 1 + listTabs.length) % listTabs.length;

            const nextTab = listTabs[nextIndex];
            if (!(nextTab instanceof HTMLButtonElement)) return;
            const value = nextTab.dataset.profileTab;
            if (value) activate(value, { focus: true, focusWithin: tablist });
          });
        }

        window.addEventListener("hashchange", () => {
          const value = readHashTab();
          if (value) activate(value, { updateHash: false });
        });

        window.addEventListener("resize", scheduleStageMeasurement);
        stableHeightQuery.addEventListener?.("change", scheduleStageMeasurement);
        window.addEventListener("load", scheduleStageMeasurement, { once: true });

        if ("fonts" in document) {
          document.fonts.ready.then(scheduleStageMeasurement).catch(() => {});
        }
      })();
    </script>
  </Section>

  <Section id="contact" className="defer-content pb-16 sm:pb-20 lg:pb-28">
    <div class="contact-unified" data-reveal>
      <div class="contact-copy-panel">
        <h2 class="text-4xl font-semibold leading-[1.05] sm:text-5xl">{t(lang, "contactTitle")}</h2>
        <p class="muted mt-6 max-w-md text-sm leading-relaxed">{t(lang, "contactSubtitle")}</p>
        <p class="muted mt-4 max-w-md text-sm leading-relaxed">{t(lang, "contact.whyIntro")}</p>

        <ul class="mt-6 space-y-2.5 text-sm leading-relaxed">
          {
            contactWhyPoints.map((point) => (
              <li class="flex gap-2.5">
                <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-zinc-500 dark:bg-zinc-400" aria-hidden="true"></span>
                <span class="muted">{point}</span>
              </li>
            ))
          }
        </ul>

        <div class="mt-8 border-t border-zinc-200 pt-5 dark:border-zinc-800">
          <p class="text-xs font-semibold uppercase tracking-[0.08em] text-zinc-600 dark:text-zinc-300">{t(lang, "contact.socialTitle")}</p>
          <div class="mt-3 flex flex-wrap gap-4">
            <a
              href="https://www.linkedin.com/in/joelarnaudcarreras/"
              target="_blank"
              rel="noopener noreferrer"
              class="ui-underline inline-flex items-center gap-2 text-sm font-medium"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M6.94 8.56H3.56V20h3.38V8.56Zm.22-3.53A1.96 1.96 0 1 0 3.24 5a1.96 1.96 0 0 0 3.92.03Zm13.28 7.87c0-3.43-1.83-5.03-4.27-5.03-1.97 0-2.85 1.08-3.34 1.84V8.56H9.44V20h3.39v-5.66c0-1.49.28-2.93 2.13-2.93 1.82 0 1.84 1.7 1.84 3.03V20h3.4v-7.1Z"></path>
              </svg>
              {t(lang, "contactLinkedIn")}
            </a>
            <a
              href="https://github.com/jowy99"
              target="_blank"
              rel="noopener noreferrer"
              class="ui-underline inline-flex items-center gap-2 text-sm font-medium"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <use href="#icon-github"></use>
              </svg>
              {t(lang, "projectGithub")}
            </a>
          </div>
        </div>
      </div>

      <div class="contact-form-panel">
        <div class="contact-form-shell">
          <form
            class="grid gap-4 sm:grid-cols-2"
            method="post"
            action="/api/contact"
            aria-label={t(lang, "contactTitle")}
            data-contact-form
            data-msg-sending={t(lang, "contact.status.sending")}
            data-msg-success={t(lang, "contact.status.success")}
            data-msg-error={t(lang, "contact.status.errorGeneric")}
            data-msg-invalid={t(lang, "contact.feedback.invalid")}
            data-msg-rate-limit={t(lang, "contact.feedback.rateLimit")}
            data-msg-unavailable={t(lang, "contact.feedback.unavailable")}
          >
              <label class="contact-field-group" for={`contact-name-${lang}`}>
                <span class="label">{`${t(lang, "contact.nameLabel")}*`}</span>
                <input
                  id={`contact-name-${lang}`}
                  type="text"
                  name="name"
                  autocomplete="name"
                  required
                  aria-required="true"
                  class="field"
                  placeholder={t(lang, "contact.namePlaceholder")}
                />
              </label>

              <label class="contact-field-group" for={`contact-email-${lang}`}>
                <span class="label">{`${t(lang, "contact.emailLabel")}*`}</span>
                <input
                  id={`contact-email-${lang}`}
                  type="email"
                  name="email"
                  autocomplete="email"
                  required
                  aria-required="true"
                  class="field"
                  placeholder={t(lang, "contact.emailPlaceholder")}
                />
              </label>

              <label class="contact-field-group sm:col-span-2" for={`contact-message-${lang}`}>
                <span class="label">{`${t(lang, "contact.messageLabel")}*`}</span>
                <textarea
                  id={`contact-message-${lang}`}
                  rows="5"
                  name="message"
                  required
                  aria-required="true"
                  class="field field-textarea"
                  placeholder={t(lang, "contact.messagePlaceholder")}
                ></textarea>
              </label>

            <input
              id={`contact-company-${lang}`}
              type="text"
              name="company"
              tabindex="-1"
              autocomplete="off"
              class="sr-only"
              aria-label={t(lang, "contact.companyField")}
              aria-hidden="true"
            />

            <input type="hidden" name="form_started_at" value="" data-contact-started-at />
            <input type="hidden" name="lang" value={lang} />
            <input type="hidden" name="redirect_to" value={`/${lang}/#contact`} />

            <button
              type="submit"
              class="btn btn-secondary w-full sm:col-span-2 motion-safe:hover:-translate-y-0.5 transition-transform"
              data-contact-submit
              data-label-default={t(lang, "contactSend")}
              data-label-sending={t(lang, "contact.status.sending")}
            >
              {t(lang, "contactSend")}
            </button>
            <p class="contact-form-status notice hidden sm:col-span-2" data-contact-status role="status" aria-live="polite" aria-hidden="true"></p>
            <p class="contact-form-toast notice hidden" data-contact-toast role="status" aria-live="polite" aria-hidden="true"></p>
            <p class="help sm:col-span-2">{t(lang, "contactNote")}</p>
          </form>
        </div>
      </div>
    </div>
  </Section>

  <script is:inline>
    (() => {
      const forms = Array.from(document.querySelectorAll("[data-contact-form]"));
      if (forms.length === 0) return;

      const queryStatus = new URLSearchParams(window.location.search).get("contact");
      const queryStatusMap = {
        sent: "success",
        invalid: "invalid",
        rate_limit: "rateLimit",
        service_unavailable: "unavailable",
        send_error: "error",
      };
      const STATUS_ANIMATION_MS = 200;
      const STATUS_SUCCESS_HIDE_MS = 5200;
      const hideTimers = new WeakMap();
      const cleanupTimers = new WeakMap();
      const SVG_NS = "http://www.w3.org/2000/svg";
      const toastMounted = new WeakSet();

      const getMessage = (form, code) => {
        const dataset = form.dataset;
        if (code === "success") return dataset.msgSuccess || "";
        if (code === "sending") return dataset.msgSending || "";
        if (code === "invalid") return dataset.msgInvalid || dataset.msgError || "";
        if (typeof code === "string" && code.startsWith("invalid_")) return dataset.msgInvalid || dataset.msgError || "";
        if (code === "rate_limited") return dataset.msgRateLimit || dataset.msgError || "";
        if (code === "service_unavailable") return dataset.msgUnavailable || dataset.msgError || "";
        if (code === "rateLimit") return dataset.msgRateLimit || dataset.msgError || "";
        if (code === "unavailable") return dataset.msgUnavailable || dataset.msgError || "";
        if (typeof code === "string" && code.trim().length > 0 && !code.includes("_")) return code;
        return dataset.msgError || "";
      };

      const createStatusIcon = (type) => {
        const svg = document.createElementNS(SVG_NS, "svg");
        svg.setAttribute("viewBox", "0 0 24 24");
        svg.setAttribute("width", "16");
        svg.setAttribute("height", "16");
        svg.setAttribute("fill", "none");
        svg.setAttribute("stroke", "currentColor");
        svg.setAttribute("stroke-width", "2");
        svg.setAttribute("stroke-linecap", "round");
        svg.setAttribute("stroke-linejoin", "round");

        if (type === "info") {
          const track = document.createElementNS(SVG_NS, "circle");
          track.setAttribute("cx", "12");
          track.setAttribute("cy", "12");
          track.setAttribute("r", "8");
          track.setAttribute("opacity", "0.3");

          const arc = document.createElementNS(SVG_NS, "path");
          arc.setAttribute("d", "M20 12a8 8 0 0 0-8-8");
          arc.setAttribute("class", "notice-spinner");

          svg.append(track, arc);
          return svg;
        }

        if (type === "success") {
          const circle = document.createElementNS(SVG_NS, "circle");
          circle.setAttribute("cx", "12");
          circle.setAttribute("cy", "12");
          circle.setAttribute("r", "9");
          circle.setAttribute("opacity", "0.3");

          const check = document.createElementNS(SVG_NS, "path");
          check.setAttribute("d", "M7 12.5l3.2 3.2L17 9.2");

          svg.append(circle, check);
          return svg;
        }

        const triangle = document.createElementNS(SVG_NS, "path");
        triangle.setAttribute("d", "M12 4.2 20 19H4L12 4.2Z");
        triangle.setAttribute("opacity", "0.3");

        const line = document.createElementNS(SVG_NS, "path");
        line.setAttribute("d", "M12 9.4v5");

        const dot = document.createElementNS(SVG_NS, "circle");
        dot.setAttribute("cx", "12");
        dot.setAttribute("cy", "16.7");
        dot.setAttribute("r", "0.7");
        dot.setAttribute("fill", "currentColor");
        dot.setAttribute("stroke", "none");

        svg.append(triangle, line, dot);
        return svg;
      };

      const renderStatusContent = (statusEl, type, message) => {
        if (!(statusEl instanceof HTMLElement)) return;
        statusEl.replaceChildren();

        const icon = document.createElement("span");
        icon.className = "notice-icon";
        icon.setAttribute("aria-hidden", "true");
        icon.append(createStatusIcon(type));

        const text = document.createElement("span");
        text.className = "notice-text";
        text.textContent = message;

        statusEl.append(icon, text);
      };

      const clearStatusTimers = (statusEl) => {
        const hideTimer = hideTimers.get(statusEl);
        if (hideTimer) {
          window.clearTimeout(hideTimer);
          hideTimers.delete(statusEl);
        }
        const cleanupTimer = cleanupTimers.get(statusEl);
        if (cleanupTimer) {
          window.clearTimeout(cleanupTimer);
          cleanupTimers.delete(statusEl);
        }
      };

      const hideStatus = (statusEl) => {
        if (!(statusEl instanceof HTMLElement)) return;
        clearStatusTimers(statusEl);
        statusEl.classList.remove("is-visible");
        statusEl.setAttribute("aria-hidden", "true");

        const cleanupTimer = window.setTimeout(() => {
          if (statusEl.classList.contains("is-visible")) return;
          statusEl.classList.add("hidden");
          statusEl.classList.remove("is-success", "is-error", "is-info");
          statusEl.replaceChildren();
        }, STATUS_ANIMATION_MS);

        cleanupTimers.set(statusEl, cleanupTimer);
      };

      const showStatus = (statusEl, type, message, { autoHideMs = 0 } = {}) => {
        if (!(statusEl instanceof HTMLElement)) return;
        if (!message) return;
        clearStatusTimers(statusEl);
        statusEl.classList.remove("hidden", "is-success", "is-error", "is-info", "is-visible");
        statusEl.setAttribute("aria-hidden", "false");
        renderStatusContent(statusEl, type, message);

        if (type === "success") {
          statusEl.classList.add("is-success");
          statusEl.setAttribute("role", "status");
          statusEl.setAttribute("aria-live", "polite");
        } else if (type === "info") {
          statusEl.classList.add("is-info");
          statusEl.setAttribute("role", "status");
          statusEl.setAttribute("aria-live", "polite");
        } else {
          statusEl.classList.add("is-error");
          statusEl.setAttribute("role", "alert");
          statusEl.setAttribute("aria-live", "assertive");
        }

        window.requestAnimationFrame(() => {
          statusEl.classList.add("is-visible");
        });

        if (autoHideMs > 0) {
          const hideTimer = window.setTimeout(() => hideStatus(statusEl), autoHideMs);
          hideTimers.set(statusEl, hideTimer);
        }
      };

      for (const node of forms) {
        if (!(node instanceof HTMLFormElement)) continue;
        const form = node;
        const statusEl = form.querySelector("[data-contact-status]");
        const toastEl = form.querySelector("[data-contact-toast]");
        const submitButton = form.querySelector("[data-contact-submit]");
        const startedAtInput = form.querySelector("[data-contact-started-at]");

        if (toastEl instanceof HTMLElement && !toastMounted.has(toastEl)) {
          document.body.append(toastEl);
          toastMounted.add(toastEl);
        }

        if (startedAtInput instanceof HTMLInputElement && !startedAtInput.value) {
          startedAtInput.value = String(Date.now());
        }

        if (queryStatus) {
          const mappedStatus = queryStatusMap[queryStatus];
          if (mappedStatus === "success") {
            hideStatus(statusEl);
            showStatus(toastEl, "success", getMessage(form, mappedStatus), { autoHideMs: STATUS_SUCCESS_HIDE_MS });
          } else if (mappedStatus) {
            hideStatus(statusEl);
            showStatus(toastEl, "error", getMessage(form, mappedStatus));
          }
        }

        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          if (!form.reportValidity()) return;

          if (!(submitButton instanceof HTMLButtonElement)) return;
          const defaultLabel = submitButton.dataset.labelDefault || submitButton.textContent || "";
          const sendingLabel = submitButton.dataset.labelSending || defaultLabel;

          submitButton.disabled = true;
          submitButton.textContent = sendingLabel;
          form.setAttribute("aria-busy", "true");
          hideStatus(toastEl);
          showStatus(statusEl, "info", getMessage(form, "sending"));

          const formData = new FormData(form);
          if (startedAtInput instanceof HTMLInputElement && !startedAtInput.value) {
            startedAtInput.value = String(Date.now());
            formData.set("form_started_at", startedAtInput.value);
          }

          try {
            const response = await fetch(form.action, {
              method: "POST",
              body: formData,
              headers: {
                accept: "application/json",
              },
            });

            const payload = await response.json().catch(() => null);
            const isSuccess = response.ok && payload && payload.ok === true;

            if (isSuccess) {
              form.reset();
              if (startedAtInput instanceof HTMLInputElement) {
                startedAtInput.value = String(Date.now());
              }
              hideStatus(statusEl);
              showStatus(toastEl, "success", getMessage(form, "success"), { autoHideMs: STATUS_SUCCESS_HIDE_MS });
              return;
            }

            const errorCode = payload && typeof payload.error === "string" ? payload.error : "error";
            hideStatus(statusEl);
            showStatus(toastEl, "error", getMessage(form, errorCode));
          } catch {
            hideStatus(statusEl);
            showStatus(toastEl, "error", getMessage(form, "error"));
          } finally {
            submitButton.disabled = false;
            submitButton.textContent = defaultLabel;
            form.removeAttribute("aria-busy");
          }
        });
      }

      if (queryStatus) {
        const nextUrl = new URL(window.location.href);
        nextUrl.searchParams.delete("contact");
        history.replaceState(null, "", `${nextUrl.pathname}${nextUrl.search}${nextUrl.hash}`);
      }
    })();
  </script>
</BaseLayout>

---
import { Picture } from "astro:assets";
import { getCollection } from "astro:content";
import ContactSection from "../../components/ContactSection.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import ProfileSection from "../../components/ProfileSection.astro";
import Section from "../../components/Section.astro";
import TechBadge from "../../components/TechBadge.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { locales, type Locale } from "../../i18n/locales";
import { t, tList } from "../../i18n/t";
import { assertLocale } from "../../utils/i18n";
import { filterProjectsByLocale, getProjectSlug } from "../../utils/projects";
import heroPhoto from "../../assets/hero/joel.jpeg";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang: Locale = assertLocale(Astro.params.lang);

const orderedProjects = filterProjectsByLocale(await getCollection("projects"), lang).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const featuredOrder = ["fincas-es-moli", "weather-app", "emotions-app"];
const featuredOrderSet = new Set(featuredOrder);
const featuredByOrder = featuredOrder
  .map((slug) => orderedProjects.find((project) => getProjectSlug(project) === slug))
  .filter((project): project is (typeof orderedProjects)[number] => Boolean(project));
const nonPinned = orderedProjects.filter((project) => !featuredOrderSet.has(getProjectSlug(project)));
const featuredProjects = [...featuredByOrder, ...nonPinned].slice(0, 4);

const projectsHref = `/${lang}/projects`;
const contactHref = `/${lang}/#contact`;
const heroStack = tList(lang, "hero.stack");
const siteOrigin = Astro.site?.toString().replace(/\/$/, "");
const localeHomeUrl = siteOrigin ? `${siteOrigin}/${lang}` : undefined;
const rootSiteUrl = siteOrigin ? `${siteOrigin}/` : undefined;
const sameAsProfiles = ["https://www.linkedin.com/in/joelarnaudcarreras/", "https://github.com/jowy99"];
const homeStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: t(lang, "siteName"),
    jobTitle: t(lang, "seo.person.jobTitle"),
    ...(localeHomeUrl ? { url: localeHomeUrl } : {}),
    sameAs: sameAsProfiles,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: t(lang, "siteName"),
    ...(rootSiteUrl ? { url: rootSiteUrl } : {}),
    inLanguage: lang,
  },
];

const heroBullets = [t(lang, "hero.bullet1"), t(lang, "hero.bullet2"), t(lang, "hero.bullet3")];
---

<BaseLayout
  lang={lang}
  title={t(lang, "meta.homeTitle")}
  description={t(lang, "meta.homeDescription")}
  structuredData={homeStructuredData}
>
  <section class="hero-section" data-reveal>
    <div class="site-container w-full">
      <div class="relative z-10 grid min-w-0 w-full items-center gap-6 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:gap-10">
          <div class="hero-copy">
            <p class="hero-kicker">{t(lang, "hero.eyebrow")}</p>
            <h1 class="hero-title">{t(lang, "hero.title")}</h1>
            <p class="muted mt-3 max-w-2xl text-base leading-relaxed sm:mt-4 sm:text-lg">{t(lang, "hero.subtitle")}</p>

            <div class="hero-actions">
              <a href={projectsHref} class="btn btn-primary hero-cta-pulse min-h-11 w-full sm:w-auto">{t(lang, "hero.ctaProjects")}</a>
              <a href={contactHref} class="btn btn-secondary min-h-11 w-full sm:w-auto">{t(lang, "hero.ctaTalk")}</a>
            </div>

            <div class="hero-mobile-glimpse order-2 sm:hidden">
              <div class="hero-mobile-thumb-shell">
                <Picture
                  src={heroPhoto}
                  alt={t(lang, "heroPhotoAlt")}
                  class="hero-mobile-thumb"
                  formats={["avif", "webp", "jpeg"]}
                  widths={[224, 320, 448]}
                  width={320}
                  height={400}
                  sizes="96px"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                />
              </div>
              <div class="hero-mobile-meta">
                <p class="hero-mobile-note">{t(lang, "heroPhotoNote")}</p>
                <p class="hero-mobile-status">
                  <span class="hero-status-dot" aria-hidden="true"></span>
                  <span>{t(lang, "hero.cardStatus")}</span>
                </p>
              </div>
            </div>

            <ul class="tech-badge-list tech-badge-list-hero order-3 mt-4">
              {
                heroStack.map((item, index) => (
                  <li style={`--chip-index: ${index};`}>
                    <TechBadge stack={item} className="hero-stack-chip" />
                  </li>
                ))
              }
            </ul>

            <ul class="hero-list order-4">
              {
                heroBullets.map((point) => (
                  <li class="hero-list-item">
                    <span class="hero-list-dot" aria-hidden="true"></span>
                    <span>{point}</span>
                  </li>
                ))
              }
            </ul>

          </div>

          <div class="hero-visual-wrap hidden sm:block">
            <div class="hero-media-frame">
              <Picture
                src={heroPhoto}
                alt={t(lang, "heroPhotoAlt")}
                class="hero-media"
                formats={["avif", "webp", "jpeg"]}
                widths={[360, 540, 720, 960]}
                width={960}
                height={960}
                sizes="(min-width: 1280px) 426px, (min-width: 1024px) 362px, 234px"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
              <span class="hero-media-caption">{t(lang, "heroPhotoNote")}</span>
            </div>

            <div class="hero-float-card">
              <p class="hero-float-title">
                <span class="hero-status-dot" aria-hidden="true"></span>
                <span>{t(lang, "hero.cardStatus")}</span>
              </p>
            </div>
          </div>
        </div>
    </div>
  </section>

  <Section id="projects" title={t(lang, "home.featuredTitle")} className="defer-content">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-6" data-reveal>
      {
        featuredProjects.map((project, index) => (
          <div>
            <ProjectCard
              lang={lang}
              slug={getProjectSlug(project)}
              title={project.data.title}
              description={project.data.description}
              cover={project.data.cover}
              stack={project.data.stack}
              links={project.data.links}
              variant="featured"
              maxStack={4}
              priority={index < 2}
            />
          </div>
        ))
      }
    </div>

    <div class="mt-6" data-reveal>
      <a href={projectsHref} class="btn btn-secondary min-h-11">{t(lang, "home.featuredCtaAll")}</a>
    </div>
  </Section>

  <ProfileSection lang={lang} />

  <ContactSection lang={lang} />
</BaseLayout>
